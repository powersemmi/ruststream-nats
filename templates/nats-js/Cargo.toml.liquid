[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

[dependencies]
# The lower bound names a release candidate because cargo leaves pre-releases out of a range that
# does not mention one; the range takes the final 0.7.0 the moment it is published.
ruststream = { version = ">=0.7.0-rc.1, <0.8.0", features = ["macros", "json", "asyncapi", "logging"] }
ruststream-nats = "0.7"
schemars = "1"
serde = { version = "1", features = ["derive"] }
